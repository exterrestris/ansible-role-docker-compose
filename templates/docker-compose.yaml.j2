{% macro shorthand(property, values, mapping_key, mapping_value, quote='', key_quote='') %}
    {{ property }}:
{%  if values is string %}
      - "{{ values }}"
{%  elif values is mapping %}
{%   for key, value in values.items() %}
      - {{ caller({mapping_key: key, mapping_value: value}) if caller is defined else key_quote ~ key ~ key_quote ~ '=' ~ quote ~ value ~ quote }}
{%   endfor %}
{%  elif values | length > 0 %}
{%   for value in values %}
      - {{ caller(value) if caller is defined else quote ~ value ~ quote }}
{%   endfor %}
{%  endif %}
{% endmacro %}
services:
{% for container in _docker_compose_containers %}
  {{ container.service_name }}:
{%  if container.container_name is defined %}
    container_name: {{ container.container_name }}
{%  endif %}
{%  if container.image is defined %}
{%   if container.image is mapping %}
{%    if container.image.tag is defined %}
    image: {{ container.image.name }}:{{ container.image.tag }}
{%    else %}
    image: {{ container.image.name }}
{%    endif %}
{%   else %}
     image: {{ container.image }}
{%   endif %}
{%  endif %}
{%  if container.build is defined %}
{%   if container.build | default('.') is mapping %}
{%    set _container_build_context = container.build.context | default('.') %}
    build:
{%    if _container_build_context.startswith('.') or _container_build_context.startswith('/') %}
      context: {{ _container_build_context }}
{%    else %}
      context: ./{{ _container_build_context }}
{%    endif %}
{%    if container.build.args is defined %}
{{ shorthand('args', container.user.groups) | indent(2, '') }}
{%-   endif %}
{%   else %}
    build: {{ container.build | default('.', true) }}
{%   endif %}
{%  endif %}
{%  if container.user is defined %}
{%   if container.user is mapping %}
{%    if container.user.user is defined %}
    user: {{ container.user.user }}{% if container.user.group is defined %}:{{ container.user.group }}{% endif +%}
{%     if container.user.groups is defined and container.user.groups %}
{{ shorthand('group_add', container.user.groups) -}}
{%     endif %}
{%    endif %}
{%   else %}
    user: {{ container.user }}
{%   endif %}
{%  endif %}
{%  if container.hostname is defined %}
    hostname: {{ container.hostname }}
{%  endif %}
{%  if container.command is defined and container.command %}
{{ shorthand('command', container.command)}}
{%- endif %}
{%  if container.cap_add is defined and container.cap_add %}
{{ shorthand('cap_add', container.cap_add)}}
{%- endif %}
{%  if container.cap_drop is defined and container.cap_drop %}
{{ shorthand('cap_drop', container.cap_drop)}}
{%- endif %}
{%  if container.sysctls is defined and container.sysctls %}
{%   call(sysctl) shorthand('sysctls', container.sysctls) %}
{%    if sysctl is mapping %}
"{{ sysctl.name }}={{ sysctl.value }}"
{%-   else %}
"{{ sysctl }}"
{%-   endif %}
{%   endcall %}
{%  endif %}
{%  if container.expose is defined and container.expose %}
{{ shorthand('expose', container.expose)}}
{%- endif %}
{%  if container.ports is defined and container.ports %}
{%   call(port) shorthand('ports', container.ports) %}
{%    if port is mapping %}
"{% if port.ip is defined %}{{ port.ip }}:{% endif %}{{ port.host | default(port.port) }}:{{ port.container | default(port.port) }}{% if port.protocol is defined %}/{{ port.protocol }}{% endif %}"
{%-   else %}
"{{ port }}"
{%-   endif %}
{%   endcall %}
{%  endif %}
{%  if container.devices is defined and container.devices %}
{%   call(device) shorthand('devices', container.devices) %}
{%    if device is mapping %}
"{{ device.source }}:{{ device.target }}"
{%-   else %}
"{{ device }}"
{%-   endif %}
{%   endcall %}
{%  endif %}
{%  if (container.volumes is defined and container.volumes) or (container.user is defined and (container.user.bind_etc | default(false))) %}
{%   call(volume) shorthand('volumes', container.volumes | default([]) | union(docker_compose_bind_etc_volumes if (container.user is defined and (container.user.bind_etc | default(false))) else [])) %}
{%    if volume is mapping -%}
        type: {{ (volume.type | default('bind')) if (volume.type | default('bind')) not in ['directory', 'file'] else 'bind' }}
{%     if (volume.type | default('bind')) != "tmpfs" %}
        source: {{ volume.source if (volume.source.startswith('/') or (volume.type | default('bind')) == "volume") else _docker_compose_project_dir ~ '/' ~ volume.source }}
{%     endif %}
        target: {{ volume.target }}
{%-    if volume.read_only | default(false) +%}
        read_only: true
{%-    endif %}
{%-   else %}
"{{ volume if volume.startswith('/') else _docker_compose_project_dir ~ '/' ~ volume }}"
{%-   endif %}
{%   endcall %}
{%  endif %}
{%  if container.networks is defined and container.networks %}
{{ shorthand('networks', container.networks)}}
{%- elif container.network_mode is defined %}
    network_mode: {{ container.network_mode }}
{%  endif %}
{%  if container.env_file is defined and container.env_file %}
{%   call(env_file) shorthand('env_file', container.env_file) %}
{%    if env_file is mapping %}
{%     if env_file.source is defined %}
{{ env_file.source if env_file.source.startswith('/') else _docker_compose_project_dir ~ '/' ~ env_file.source }}
{%-    else %}
{{ _docker_compose_project_dir ~ '/' ~ container.service_name ~ '.env' }}
{%-    endif %}
{%-   else %}
{{ env_file }}
{%-   endif %}
{%   endcall %}
{%  endif %}
{%  if container.environment is defined and container.environment %}
{%   call(env) shorthand('environment', container.environment, 'name', 'value', '"') %}
{%    if env is mapping %}
"{{ env.name }}={{ env.value | replace("\"", "\\\"") }}"
{%-   else %}
"{{ env | replace("\"", "\\\"") }}"
{%-   endif %}
{%   endcall %}
{%  endif %}
{%  if container.restart is defined %}
    restart: {{ container.restart }}
{%  endif %}
{%  if container.labels is defined and container.labels %}
{%   call(label) shorthand('labels', container.labels) %}
{%    if label is mapping %}
"{{ label.name }}{% if label.value is defined %}={{ label.value }}{% endif %}"
{%-   else %}
"{{ label }}"
{%-   endif %}
{%   endcall %}
{%  endif %}
{% endfor %}

{% if _docker_compose_volumes | length > 0 %}
volumes:
{%  for volume in _docker_compose_volumes %}
  {{ volume.name }}:
    external: {{ volume.external | default('false') | string | lower }}
{%   if volume.alias is defined %}
    name: {{ volume.alias }}
{%   endif %}
{%   if volume.driver is defined %}
    driver: {{ network.driver }}
{%   endif %}
{%   if volume.driver_opts is defined %}
    driver_opts:
{%    for opt, value in volume.driver_opts.items() %}
      {{ opt }}: {{ value }}
{%    endfor %}
{%   endif %}
{%   if volume.labels is defined and volume.labels %}
{%    call(label) shorthand('labels', volume.labels) %}
{%     if label is mapping %}
"{{ label.name }}{% if label.value is defined %}={{ label.value }}{% endif %}"
{%-    else %}
"{{ label }}"
{%-    endif %}
{%    endcall %}
{%   endif %}
{%  endfor %}
{% endif %}

{% if _docker_compose_networks | length > 0 %}
networks:
{%  for network in _docker_compose_networks %}
  {{ network.name }}:
    external: {{ network.external | default('false') | string | lower }}
{%   if network.alias is defined %}
    name: {{ network.alias }}
{%   endif %}
{%   if network.driver is defined %}
    driver: {{ network.driver }}
{%   endif %}
{%   if network.driver_opts is defined %}
    driver_opts:
{%    for opt, value in network.driver_opts.items() %}
      {{ opt }}: {{ value }}
{%    endfor %}
{%   endif %}
{%   if network.ipam is defined %}
    ipam:
{%    if network.ipam.driver is defined %}
      driver: {{ network.ipam.driver }}
{%    endif %}
{%    if network.ipam.config is defined and network.ipam.config %}
      config:
{%     for config in network.ipam.config %}
        - subnet: {{ config.subnet }}
          ip_range: {{ config.ip_range }}
          gateway: {{ config.gateway }}
{%      if config.aux_addresses is defined %}
          aux_addresses:
{%       for opt, value in config.aux_addresses.items() %}
            {{ opt }}: {{ value }}
{%-      endfor %}
{%-     endif %}
{%-    endfor %}
{%-   endif %}
{%    if network.ipam.options is defined %}
      options:
{%     for opt, value in network.driver_opts.items() %}
      {{ opt }}: {{ value }}
{%     endfor %}
{%    endif %}
{%   endif %}
{%   if network.labels is defined and network.labels %}
{%    call(label) shorthand('labels', network.labels) %}
{%     if label is mapping %}
"{{ label.name }}{% if label.value is defined %}={{ label.value }}{% endif %}"
{%-    else %}
"{{ label }}"
{%-    endif %}
{%    endcall %}
{%   endif %}
{%  endfor %}
{% endif %}
